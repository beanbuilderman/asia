# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://asia:<password>@localhost:5435/asia_dev
AUTH_SECRET=<64 hex chars: openssl rand -hex 32>
SITE_URL=http://localhost:3200
# Used by the seed script to create the first dashboard login.
SEED_ADMIN_EMAIL=
# Online only: Vercel Blob store for uploaded photos.
BLOB_READ_WRITE_TOKEN=
# "Forgotten password" emails. Mailpit locally (brew services start mailpit, inbox at http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Asia Joanna Rob website <no-reply@asiajoannarob.com>"
